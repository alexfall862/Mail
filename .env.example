# KDP Mail Approval — environment variables (SPEC.md §14)
# Copy to .env for local development. Never commit .env.

# Postgres connection string.
# Local dev (docker-compose): postgres://postgres:postgres@localhost:5432/kdp_mail
# Production: provided by Railway's Postgres plugin.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kdp_mail

# Public base URL of the app, no trailing slash. Used in magic links and emails.
# e.g. https://mail.kansasdems.org (local dev: http://localhost:3000)
APP_URL=http://localhost:3000

# Cloudflare R2 (private bucket, S3-compatible). See SETUP_CHECKLIST.md §1.
# Account ID from the R2 overview page sidebar.
R2_ACCOUNT_ID=
# API token scoped to the bucket with Object Read & Write permission.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (kept private; all access via presigned URLs).
R2_BUCKET=kdp-mail-approval

# Resend transactional email. See SETUP_CHECKLIST.md §3.
RESEND_API_KEY=
# From header for all outgoing mail; the domain must be verified in Resend.
EMAIL_FROM=KDP Mail Program <approval@mail.kansasdems.org>

# Cloudflare Turnstile bot protection. See SETUP_CHECKLIST.md §2.
# Site key is public (rendered client-side); secret key is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OpenAI API key for the advisory AI pre-check on submitted artwork
# (claims/citations, "Paid for by" disclaimer, spelling). Optional: with no
# key set, pre-checks are recorded as failed events and everything else works.
OPENAI_API_KEY=

# Optional. Shown on the admin login page as the address to write to for a
# password reset (there is no self-service reset; a superuser resets manually).
# With nothing set, the page just says to ask a superuser.
ADMIN_SUPPORT_EMAIL=

# Initial superuser, seeded idempotently by `npm run db:seed`.
# The password is temporary — a change is forced on first login.
SEED_SUPERUSER_EMAIL=alex@kansasdems.org
SEED_SUPERUSER_PASSWORD=
